{
  "$schema": "./tokens.schema.json",
  "meta": {
    "name": "Pod design tokens",
    "version": "1.0.0",
    "source": "Claude Design",
    "note": "Platform-agnostic. iOS and Android consume the same tokens through generated constants; they do NOT share a UI layer. Never hardcode a raw value in a screen — add it here first."
  },
  "color": {
    "light": {
      "surface.canvas":        { "value": "#FBF7F2", "role": "app background" },
      "surface.raised":        { "value": "#FFFFFF", "role": "cards, sheets" },
      "surface.sunken":        { "value": "#F1EAE1", "role": "inset wells, input backgrounds" },
      "surface.scrim":         { "value": "#1A1714", "alpha": 0.36, "role": "modal scrim" },
      "content.primary":       { "value": "#1A1714", "role": "body + headline text" },
      "content.secondary":     { "value": "#5C544B", "role": "supporting text" },
      "content.tertiary":      { "value": "#8C8177", "role": "timestamps, hints" },
      "content.onAccent":      { "value": "#FFFBF6", "role": "text on accent fills" },
      "accent.primary":        { "value": "#C2603C", "role": "primary action" },
      "accent.pressed":        { "value": "#A24E2F", "role": "primary action, pressed" },
      "accent.subtle":         { "value": "#F6E2D8", "role": "accent-tinted background" },
      "state.posted":          { "value": "#4F7A5B", "role": "a member has posted this week" },
      "state.postedSubtle":    { "value": "#DFEAE0", "role": "posted, as a fill" },
      "state.open":            { "value": "#B9AFA3", "role": "not posted YET — neutral, never a warning" },
      "state.openSubtle":      { "value": "#EDE6DD", "role": "open, as a fill" },
      "state.resting":         { "value": "#8C93A8", "role": "week closed without a proof — calm, never red" },
      "state.restingSubtle":   { "value": "#E4E6EC", "role": "resting, as a fill" },
      "border.hairline":       { "value": "#1A1714", "alpha": 0.10, "role": "dividers" },
      "border.strong":         { "value": "#1A1714", "alpha": 0.22, "role": "input borders, focus ring base" },
      "focus.ring":            { "value": "#2F6F8F", "role": "keyboard/switch-access focus" }
    },
    "dark": {
      "surface.canvas":        { "value": "#14120F" },
      "surface.raised":        { "value": "#1F1C18" },
      "surface.sunken":        { "value": "#0E0C0A" },
      "surface.scrim":         { "value": "#000000", "alpha": 0.52 },
      "content.primary":       { "value": "#F4EFE8" },
      "content.secondary":     { "value": "#B7ADA1" },
      "content.tertiary":      { "value": "#877D72" },
      "content.onAccent":      { "value": "#14120F" },
      "accent.primary":        { "value": "#E68A62" },
      "accent.pressed":        { "value": "#C97049" },
      "accent.subtle":         { "value": "#3A2A22" },
      "state.posted":          { "value": "#8FBE9C" },
      "state.postedSubtle":    { "value": "#26332A" },
      "state.open":            { "value": "#6E655C" },
      "state.openSubtle":      { "value": "#262220" },
      "state.resting":         { "value": "#9AA1B5" },
      "state.restingSubtle":   { "value": "#232630" },
      "border.hairline":       { "value": "#F4EFE8", "alpha": 0.12 },
      "border.strong":         { "value": "#F4EFE8", "alpha": 0.24 },
      "focus.ring":            { "value": "#7FB6D4" }
    },
    "forbidden": {
      "note": "There is deliberately no `error`, `danger`, or `warning` colour for member or pod state. Missing a week is never rendered in a failure colour (CLAUDE.md §2.1). A destructive-confirm red may be added ONLY for account deletion, and must be recorded in docs/DECISIONS.md first."
    }
  },
  "typography": {
    "family": {
      "ios":     { "value": "SF Pro (system)", "note": "system font, Dynamic Type" },
      "android": { "value": "Roboto Flex (system)", "note": "system font, respects font scale" }
    },
    "scale": {
      "display":   { "size": 34, "lineHeight": 40, "weight": 600, "tracking": -0.4, "role": "the one number on the pod screen" },
      "title":     { "size": 24, "lineHeight": 30, "weight": 600, "tracking": -0.2 },
      "heading":   { "size": 19, "lineHeight": 25, "weight": 600, "tracking": 0 },
      "body":      { "size": 16, "lineHeight": 23, "weight": 400, "tracking": 0 },
      "bodyStrong":{ "size": 16, "lineHeight": 23, "weight": 600, "tracking": 0 },
      "caption":   { "size": 13, "lineHeight": 18, "weight": 400, "tracking": 0.1 },
      "micro":     { "size": 11, "lineHeight": 15, "weight": 500, "tracking": 0.4 }
    },
    "rule": "Sizes are Dynamic Type / font-scale baselines, not fixed points. Never disable scaling."
  },
  "spacing": {
    "unit": 4,
    "xs": 4, "sm": 8, "md": 12, "lg": 16, "xl": 24, "xxl": 32, "xxxl": 48,
    "screenGutter": 20,
    "sectionGap": 32
  },
  "radius": { "sm": 8, "md": 14, "lg": 22, "pill": 999 },
  "size": {
    "minTouchTarget": 44,
    "ringStroke": 10,
    "ringDiameter": 176,
    "avatarSm": 32,
    "avatarMd": 44,
    "primaryButtonHeight": 52
  },
  "elevation": {
    "flat":    { "y": 0, "blur": 0,  "alpha": 0.00 },
    "raised":  { "y": 1, "blur": 3,  "alpha": 0.08 },
    "sheet":   { "y": 8, "blur": 24, "alpha": 0.16 }
  },
  "motion": {
    "duration": { "instant": 90, "quick": 160, "standard": 240, "settle": 420 },
    "easing": {
      "standard": [0.2, 0.0, 0.0, 1.0],
      "emphasized": [0.2, 0.0, 0.0, 1.0],
      "exit": [0.4, 0.0, 1.0, 1.0]
    },
    "rule": "Nothing celebratory lasts longer than `settle`. No confetti, no streak-break animation. Respect reduce-motion: fall back to a cross-fade."
  },
  "opacity": { "disabled": 0.38, "pressed": 0.72 }
}
