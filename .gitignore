# Build output
backend/bin/
*.test

# Local environment
.env
.env.local

# iOS
ios/**/.build/
ios/**/*.xcodeproj/
ios/**/*.xcworkspace/
ios/**/xcuserdata/
ios/**/DerivedData/
.swiftpm/

# Android
android/.gradle/
android/build/
android/**/build/
android/local.properties
android/.idea/
*.iml

# Tooling
.DS_Store
node_modules/
.blobs/

# Kotlin compiler scratch, written by any gradle invocation.
android/.kotlin/

# Design
# The seeded canvas is ~2 MB of editor payload built from the artboards beside it.
# The .dc.html artboards are source and are kept — hence the exception, which has
# to come second: a later negation is what un-ignores a match.
design/mockups/*.html
!design/mockups/*.dc.html
design/mockups/__pycache__/
